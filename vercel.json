{
  "redirects": [
    {
      "source": "/",
      "destination": "/products",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/sitemap.xml",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/xml; charset=utf-8"
        }
      ]
    },
    {
      "source": "/robots.txt",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/products/:slug*",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(facebookexternalhit|Facebot|meta-externalagent|Instagram|Twitterbot|LinkedInBot|Pinterest|Slackbot|Discordbot|WhatsApp|TelegramBot|Linespider|SkypeUriPreview|Iframely|Embedly|redditbot|Applebot|vkShare|Viber).*"
        }
      ],
      "destination": "/api/product-og?slug=:slug*"
    },
    {
      "source": "/((?!api(?:/|$)|.*\\.).*)",
      "destination": "/index.html"
    }
  ]
}
